FROM python:3.11-slim

WORKDIR /app
COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY dashboard /app/dashboard
RUN useradd --system --uid 10002 --create-home --home-dir /home/dashboard dashboard \
    && mkdir -p /home/dashboard/.streamlit \
    && chown -R dashboard:dashboard /home/dashboard /app

ENV HOME=/home/dashboard
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
USER dashboard
EXPOSE 8501
CMD ["streamlit","run","dashboard/app.py","--server.address=0.0.0.0","--server.port=8501","--server.headless=true"]
