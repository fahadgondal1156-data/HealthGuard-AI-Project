APP_NAME=HealthGuard-AI
APP_ENV=production

# PostgreSQL server deployment. DATABASE_URL and POSTGRES_PASSWORD must use the same password.
DATABASE_URL=postgresql+psycopg2://healthguard:CHANGE_ME@db:5432/healthguard
POSTGRES_DB=healthguard
POSTGRES_USER=healthguard
POSTGRES_PASSWORD=CHANGE_ME

# Authentication
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Model artifacts
MODEL_DIR=/app/models/24h

# Network binding for Docker API. Use 127.0.0.1 locally or a private server IP when required.
BIND_IP=127.0.0.1
